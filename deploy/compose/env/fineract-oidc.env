# VALEURS FICTIVES, pile de développement uniquement (ADR-010, ADR-018).
# Fineract en serveur de ressources OAuth2 : il accepte les jetons du royaume Keycloak nkulkap et retrouve
# l'utilisateur Fineract de même nom (preferred_username). Les autorisations restent celles des rôles Fineract.
# Effet de bord connu : la chaîne OIDC traite tout /api/**, l'authentification Basic n'est plus acceptée.
FINERACT_SECURITY_OIDC_FEDERATION_ENABLED=true
FINERACT_SECURITY_OIDC_USERNAME_CLAIM=preferred_username
FINERACT_SECURITY_OIDC_TENANT_CLAIM=fineract_tenant
# Jamais de création automatique : un utilisateur Keycloak sans compte Fineract est refusé.
FINERACT_SECURITY_OIDC_AUTO_CREATE_USER=false
FINERACT_SECURITY_OIDC_PROVIDER=keycloak
# Émetteur accepté : la valeur exacte de « iss » des jetons délivrés au poste (localhost:8180). Les clés de
# signature sont lues par le réseau Compose (keycloak:8080), d'où un jwks-uri distinct.
FINERACT_SECURITY_OIDCFEDERATION_ISSUERS_0_ISSUERURI=http://localhost:8180/realms/nkulkap
FINERACT_SECURITY_OIDCFEDERATION_ISSUERS_0_JWKSURI=http://keycloak:8080/realms/nkulkap/protocol/openid-connect/certs
FINERACT_SECURITY_OIDCFEDERATION_ISSUERS_0_TENANTID=default
# Contournement d'un défaut de Fineract b94b2ddf : dépendance circulaire entre OidcFederationSecurityConfig et
# DynamicJwtIssuerAuthenticationManagerResolver, qui empêche le démarrage en mode OIDC (ADR-018).
SPRING_MAIN_ALLOWCIRCULARREFERENCES=true
